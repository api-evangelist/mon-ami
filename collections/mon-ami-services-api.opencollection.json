{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mon Ami REST Care Plans Services API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Services",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List service definitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.monami.io/api/service_definitions"
          },
          "docs": "List service definitions"
        },
        {
          "info": {
            "name": "Get a service definition",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.monami.io/api/service_definitions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a service definition"
        },
        {
          "info": {
            "name": "List service rates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.monami.io/api/service_rates"
          },
          "docs": "List service rates"
        },
        {
          "info": {
            "name": "Get a service rate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.monami.io/api/service_rates/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a service rate"
        },
        {
          "info": {
            "name": "List service records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.monami.io/api/service_records",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (default 1)."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Results per page (default 25, max 50)."
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Filter object. Filters nest under a single q parameter using q[field]=value (or q[field][]=v1&q[field][]=v2 for multiple values)."
              }
            ]
          },
          "docs": "List service records"
        },
        {
          "info": {
            "name": "Create a service record",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.monami.io/api/service_records",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a service record"
        },
        {
          "info": {
            "name": "Get a service record",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.monami.io/api/service_records/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a service record"
        }
      ]
    }
  ],
  "bundled": true
}